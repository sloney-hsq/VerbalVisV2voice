# Qwen Realtime credentials. An API key uses the DashScope public endpoint.
DASHSCOPE_API_KEY=sk-your-api-key
QWEN_WORKSPACE_ID=
QWEN_REGION=beijing

# Optional overrides
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_VOICE=Ethan
QWEN_VAD_THRESHOLD=0.4
QWEN_VAD_SILENCE_DURATION_MS=800

# Optional override: provide a complete regional endpoint.
# QWEN_REALTIME_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
